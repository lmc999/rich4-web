# 大富翁4 联机版部署环境（复制为 deploy/.env 再填写；deploy/.env 已被 .gitignore 与 .dockerignore 排除）
# 变量含义见 docs/architecture.md §9.2 与 apps/server/src/config.ts。
# deploy/.env 有两个用途：app 容器的环境变量（docker-compose.yml 的 env_file），以及 compose 文件里 ${...} 的插值
# （SITE_ADDRESS、端口、日志轮转；这几项进了容器也会被服务器忽略）。
# 注意：docker compose 会对 .env / env_file 里未加引号的 `$` 做变量插值，值里不要出现 `$`
# （下面的密钥与口令哈希都由 scripts/access.ts 或 openssl rand -base64 生成，本身不含 `$`）。

# ───────────── 基础 ─────────────
# Caddy 站点地址：域名（自动申请 Let's Encrypt 证书，并发 HSTS）或 localhost（Caddy 内部 CA，不发 HSTS）
SITE_ADDRESS=rich4.example.com
# 对外地址：邀请链接、og 信息；为 https 时访问 cookie 带 Secure（开启访问门禁时生产环境必填，应为 https）
PUBLIC_URL=https://rich4.example.com
# 存档签名密钥（必填，≥32 字节）：openssl rand -base64 48 或 npx tsx scripts/access.ts secret
SAVE_HMAC_SECRET=
LOG_LEVEL=info
MAX_ROOMS=500
ROOM_ABANDON_TTL_MIN=30
# 可选：/admin/stats 与门禁管理接口（/admin/access/*）的 Bearer token（不用时保持注释）。
# 它能签发邀请码、吊销全部会话：开启访问门禁时至少 32 字节（npx tsx scripts/access.ts secret 或 openssl rand -base64 48）；
# 鉴权失败按 IP 退避并记日志。容器部署里签发邀请码、吊销都要靠它（镜像里没有 scripts/access.ts）。
# 值不要加引号：下面的 curl 示例直接从本文件读取它。
# ADMIN_TOKEN=
DEFAULT_MAP=taiwan
STORE=sqlite
# 每日备份：/data/backup/rich4-YYYYMMDD.db，保留最近 BACKUP_KEEP 份
BACKUP_ENABLED=1
BACKUP_KEEP=7
# 不要在这里设置 RICH4_TEST_MODE：它开放 debug:act（可任意改写对局）；生产环境（NODE_ENV=production）下服务器
# 只在 PUBLIC_URL 为 localhost 时接受它，专供本机验证（deploy/docker-compose.e2e.yml）。

# ───────────── 端口与日志轮转（docker compose 插值） ─────────────
# 宿主端口：公网部署保持 80 / 443（证书签发与 HTTP→HTTPS 跳转都假定对外就是 80 / 443）；HTTP/3 用 HTTPS_PORT 的同号 UDP 端口。
# 改端口只适合前面另有反代或隧道的场合（此时 PUBLIC_URL 写对外的地址）。
HTTP_PORT=80
HTTPS_PORT=443
# 只绑定某个宿主地址，例如 127.0.0.1（前面另有反代或隧道时）；留空绑定全部地址（IPv4 与 IPv6）。
# 即使为空也保留这一行：compose 对未定义的变量会打印告警。
BIND_ADDR=
# compose 网络开启 IPv6（需要 Docker Engine 27+）：IPv6 访客经 NAT 进来、保留真实地址。设为 false 时 IPv6 访客由
# docker-proxy 转发，全部显示成同一个网关 IP、共用按 IP 的限流与门禁退避——那就不要给域名加 AAAA 记录（或者
# BIND_ADDR 写主机的 IPv4 地址，只接 IPv4）。只有主机内核禁用了 IPv6、up 时报 IPv6 相关错误时才改成 false。
ENABLE_IPV6=true
# Caddy 前面另有反代、隧道或 CDN 时，列出它们的网段（空格分隔），Caddy 才会从它们转来的 X-Forwarded-For 里取真实
# 客户端 IP；不设置时所有玩家都显示成那一跳的地址（详见 deploy/Caddyfile 文件头）。例如：
#   本机的前置反代 / 隧道（BIND_ADDR=127.0.0.1）：CADDY_TRUSTED_PROXIES=private_ranges
#   CDN：它公布的回源网段，如 CADDY_TRUSTED_PROXIES=173.245.48.0/20 103.21.244.0/22 …
# 端口对公网开放（BIND_ADDR 为空）时不要写 private_ranges。
CADDY_TRUSTED_PROXIES=
# 容器日志（json-file）单个文件上限与保留个数：每个容器最多约 LOG_MAX_SIZE × LOG_MAX_FILE
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# ───────────── 原版皮肤素材包（可选；docs/design/original-skin.md） ─────────────
# 素材包由 docker-compose.yml 以只读方式挂载到 /assets-rich4（RICH4_ASSETS_DIR 已在 compose 里设置）。
# 宿主机上 ../rich4-assets 里有 manifest.json 时即启用，此时下面的访问门禁**必须**开启，否则服务器拒绝启动。
# 启动校验：quick 只查结构、文件存在与字节数；full 另外逐个复算 sha256（约 200 MB，启动慢几秒）
RICH4_ASSETS_VERIFY=quick

# ───────────── 访问门禁（启用原版素材包时必填） ─────────────
# off：不设门禁（默认；只能用于没有素材包的部署——挂载了素材包而仍为 off 时服务器拒绝启动）
# passcode：共享口令（推荐）；也接受管理员生成的邀请码。启用原版皮肤时改为 passcode，并填好下面的哈希与密钥
# invite：只接受邀请码（管理员用 ADMIN_TOKEN 调 POST /admin/access/invites；容器部署必须设置 ADMIN_TOKEN）
ACCESS_MODE=off
# 口令的 scrypt 哈希（不存明文；ACCESS_MODE=passcode 时必填），在本机生成：
#   npx tsx scripts/access.ts hash            交互输入两次，不回显
#   echo '口令' | npx tsx scripts/access.ts hash --stdin
# 格式 scrypt:<N>:<r>:<p>:<salt>:<hash>
ACCESS_PASSCODE_HASH=
# cookie 签名密钥（≥32 字节；ACCESS_MODE 非 off 时必填）：npx tsx scripts/access.ts secret；更换它会让所有人重新输入口令
ACCESS_SECRET=
# 口令 / 邀请码登录后 cookie 的有效天数（用过就滑动续期）；素材在浏览器里最多缓存 30 天
ACCESS_TTL_DAYS=30
# 1：已通过口令的玩家可以在房间页生成「邀请链接」（24 小时内有效、最多 8 人使用，朋友不用知道口令）
ACCESS_GRANTS=1
# 管理（容器部署：镜像里只有 server/main.mjs，没有 scripts/access.ts，一律用 ADMIN_TOKEN 调管理接口）。
# 在仓库根目录执行；token 从本文件读出、经标准输入交给 curl（-H @-，curl ≥ 7.55），不出现在命令行、ps 与 shell 历史里：
#   生成邀请码：sed -n 's/^ADMIN_TOKEN=/Authorization: Bearer /p' deploy/.env | curl -fsS -X POST -H @- \
#                 -H 'Content-Type: application/json' -d '{"uses":5,"days":7,"note":"朋友"}' https://rich4.example.com/admin/access/invites
#   列出邀请码与 epoch：sed -n 's/^ADMIN_TOKEN=/Authorization: Bearer /p' deploy/.env | curl -fsS -H @- \
#                 https://rich4.example.com/admin/access/invites
#   吊销全部会话与未兑换的邀请链接：
#               sed -n 's/^ADMIN_TOKEN=/Authorization: Bearer /p' deploy/.env | curl -fsS -X POST -H @- \
#                 https://rich4.example.com/admin/access/revoke
# 源码部署（或能直接访问数据卷里 rich4.db 的机器）也可以用 CLI：DATA_DIR=<服务器的数据目录> npx tsx scripts/access.ts revoke
#   CLI 只打开已存在的库（路径打错会报错，不会新建空库），输出里带库路径与旧 / 新 epoch，核对后再确认吊销生效。

# 只在本机开发用：素材包存在但不设门禁。仅当 NODE_ENV!=production、PUBLIC_URL 为 localhost、TRUST_PROXY=0、
# HOST 为回环地址（不设时自动只监听 127.0.0.1）时生效，compose 部署（NODE_ENV=production、TRUST_PROXY=1）下永远不生效。
# RICH4_ASSETS_ALLOW_UNGATED=0
