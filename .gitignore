# 原版正版文件与派生数据：永不入库（见 docs/architecture.md §9.3）
original/
.cache/
rich4-data/
**/*.mkf
**/*.MKF
**/RICH4.EXE
**/rich4.exe
**/SAVE*.DAT

# 构建与依赖
node_modules/
dist/
coverage/
test-results/
playwright-report/
*.tsbuildinfo
.DS_Store
# 口令、密钥与本机数据（与 .dockerignore 一致）：部署用的 .env 及其副本（.env.bak、.env.prod、prod.env……）、
# sqlite 库与备份（rich4-YYYYMMDD.db，含门禁邀请码与授权、全部存档）、存档导出
.env
.env.*
*.env
!.env.example
!deploy/.env.example
deploy/.env
*.db
*.db-wal
*.db-shm
*.r4save

# vitest 附件
.vitest/

# 临时调试脚本的产物（截图等）
test/**/*.png

# 原版素材包（私用派生，永不入库/进镜像）
rich4-assets/
**/*.flc
**/*.fli

# Python 字节码
__pycache__/
*.pyc
